generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  PLATFORM_ADMIN
  CITY_ADMIN
  OPERATOR
  Clerk
  Superintendent
  Officer
  Admin
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

enum Provider {
  META
}

enum MessageType {
  SINGLE
  BULK
}

enum MessageStatus {
  DRAFT
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  CANCELLED
}

enum BulkOperationStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SettingsScope {
  GLOBAL
  CITY
}

// =========================================================
// USERS
// =========================================================

model User {
  id           String    @id @default(cuid()) @map("_id")
  email        String    @unique
  username     String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  cityId       String?
  officeId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  departmentId String?
  deskName     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city       City?       @relation("CityUsers", fields: [cityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  office     Office?     @relation(fields: [officeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  department Department? @relation("DepartmentUsers", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdCities City[]       @relation("CityCreatedBy")
  documents     Document[]
  messageLogs   MessageLog[] @relation("OperatorMessageLogs")

  auditLogs AuditLog[] @relation("AuditActor")

  operatorProfile  Operator?
  createdOperators Operator[] @relation("OperatorCreatedBy")

  tapals            Tapal[]      @relation("CurrentHolder")
  sentMovements     Movement[]   @relation("FromUser")
  receivedMovements Movement[]   @relation("ToUser")
  headedDepartments Department[] @relation("HeadOfDepartment")

  @@index([role])
  @@index([cityId])
  @@index([officeId])
  @@index([departmentId])
  @@map("users")
}

// =========================================================
// CITIES
// =========================================================

model City {
  id       String  @id @default(cuid()) @map("_id")
  name     String
  code     String  @unique
  state    String
  district String?
  isActive Boolean @default(true)

  whatsappMonthlyLimit Int @default(0)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("CityCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  users          User[]              @relation("CityUsers")
  operators      Operator[]
  documents      Document[]
  bulkOperations BulkOperation[]
  templates      Template[]
  settings       MessagingSettings[]
  auditLogs      AuditLog[]
  recipients     Recipient[]
  messageLogs    MessageLog[]
  departments    Department[]
  tapals         Tapal[]
  offices        Office[]

  @@index([isActive])
  @@map("cities")
}

// =========================================================
// OPERATORS
// =========================================================

model Operator {
  id String @id @default(cuid()) @map("_id")

  userId      String @unique
  cityId      String
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City @relation(fields: [cityId], references: [id])
  createdBy User @relation("OperatorCreatedBy", fields: [createdById], references: [id])

  bulkOperations BulkOperation[]
  recipients     Recipient[]

  @@index([cityId])
  @@index([createdById])
  @@map("operators")
}

// =========================================================
// DOCUMENTS
// =========================================================

model Document {
  id String @id @default(cuid()) @map("_id")

  title        String?
  originalName String
  storedName   String
  fileUrl      String

  fileSize BigInt
  mimeType String

  uploadedById String
  cityId       String

  recipientMobile String?
  status          String  @default("UPLOADED")

  messageType MessageType @default(SINGLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  city       City @relation(fields: [cityId], references: [id])

  bulkOperations BulkOperation[]
  recipients     Recipient[]
  messageLogs    MessageLog[]

  @@index([uploadedById])
  @@index([cityId])
  @@map("documents")
}

// =========================================================
// BULK OPERATIONS
// =========================================================

model BulkOperation {
  id String @id @default(cuid()) @map("_id")

  name String

  cityId     String
  operatorId String
  documentId String

  csvFileUrl String

  channel  Channel
  provider Provider

  totalRecipients Int @default(0)
  queuedCount     Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  readCount       Int @default(0)
  failedCount     Int @default(0)

  status BulkOperationStatus @default(DRAFT)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city     City     @relation(fields: [cityId], references: [id])
  operator Operator @relation(fields: [operatorId], references: [userId])
  document Document @relation(fields: [documentId], references: [id])

  recipients Recipient[]

  @@index([cityId])
  @@index([operatorId])
  @@index([status])
  @@map("bulk_operations")
}

// =========================================================
// RECIPIENTS
// =========================================================

model Recipient {
  id String @id @default(cuid()) @map("_id")

  cityId     String
  operatorId String

  documentId      String?
  bulkOperationId String?

  fullName String?
  mobile   String

  status MessageStatus @default(QUEUED)

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city          City           @relation(fields: [cityId], references: [id])
  operator      Operator       @relation(fields: [operatorId], references: [userId])
  document      Document?      @relation(fields: [documentId], references: [id])
  bulkOperation BulkOperation? @relation(fields: [bulkOperationId], references: [id])

  messageLogs MessageLog[]

  @@index([mobile])
  @@index([status])
  @@index([bulkOperationId])
  @@index([documentId])
  @@map("recipients")
}

// =========================================================
// MESSAGE LOGS
// =========================================================

model MessageLog {
  id String @id @default(cuid()) @map("_id")

  recipientId     String
  cityId          String
  operatorId      String
  bulkOperationId String?
  documentId      String?

  recipientMobile String
  body            String?

  provider Provider
  channel  Channel

  providerMessageId String?

  payload          Json?
  providerResponse Json?

  error String?

  retryCount Int @default(0)

  status MessageStatus @default(QUEUED)

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  lastRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  city      City      @relation(fields: [cityId], references: [id])
  operator  User      @relation("OperatorMessageLogs", fields: [operatorId], references: [id])
  document  Document? @relation(fields: [documentId], references: [id])

  @@index([recipientId])
  @@index([cityId])
  @@index([operatorId])
  @@index([bulkOperationId])
  @@index([status])
  @@map("message_logs")
}

// =========================================================
// TEMPLATES
// =========================================================

model Template {
  id String @id @default(cuid()) @map("_id")

  cityId String?

  name String

  channel  Channel
  provider Provider

  body String

  metaTemplateName String?

  languageCode String @default("en")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City? @relation(fields: [cityId], references: [id])

  @@index([cityId])
  @@index([channel])
  @@map("templates")
}

// =========================================================
// MESSAGING SETTINGS
// =========================================================

model MessagingSettings {
  id String @id @default(cuid()) @map("_id")

  scope SettingsScope @default(GLOBAL)

  cityId String?

  metaAccessToken   String?
  metaPhoneNumberId String?
  metaApiVersion    String  @default("v19.0")

  preferredProvider Provider @default(META)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City? @relation(fields: [cityId], references: [id])

  @@index([scope])
  @@index([cityId])
  @@map("messaging_settings")
}

// =========================================================
// AUDIT LOGS
// =========================================================

model AuditLog {
  id String @id @default(cuid()) @map("_id")

  actorId String
  cityId  String?

  action     String
  entityType String
  entityId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User  @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  city  City? @relation(fields: [cityId], references: [id])

  @@index([actorId])
  @@index([cityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// =========================================================
// OFFICES
// =========================================================

model Office {
  id               String       @id @default(cuid()) @map("_id")
  name             String
  code             String       @unique
  cityId           String
  city             City         @relation(fields: [cityId], references: [id])
  users            User[]
  departments      Department[]
  tapals           Tapal[]
  whatsappDisabled Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("offices")
}

// =========================================================
// DEPARTMENTS
// =========================================================

model Department {
  id                 String   @id @default(cuid()) @map("_id")
  name               String
  code               String   @unique
  headOfDepartmentId String?
  headOfDepartment   User?    @relation("HeadOfDepartment", fields: [headOfDepartmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  cityId             String
  city               City     @relation(fields: [cityId], references: [id])
  officeId           String
  office             Office   @relation(fields: [officeId], references: [id])
  users              User[]   @relation("DepartmentUsers")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tapals             Tapal[]

  @@index([officeId])
  @@map("departments")
}

// =========================================================
// TAPALS & MOVEMENTS
// =========================================================

type SenderDetails {
  organization      String?
  senderName        String?
  referenceLetterNo String?
  receivedDate      DateTime?
}

type FileAttachment {
  storageKey       String
  originalFilename String?
  fileSizeBytes    Int?
}

model Tapal {
  id              String         @id @default(cuid()) @map("_id")
  trackingNumber  String         @unique
  type            TapalType
  subject         String
  senderDetails   SenderDetails?
  currentHolderId String
  currentHolder   User           @relation("CurrentHolder", fields: [currentHolderId], references: [id])
  status          TapalStatus    @default(New)
  fileAttachment  FileAttachment
  cityId          String
  city            City           @relation(fields: [cityId], references: [id])
  officeId        String
  office          Office         @relation(fields: [officeId], references: [id])
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  movements       Movement[]

  @@index([cityId])
  @@index([officeId])
  @@index([currentHolderId])
  @@index([status])
  @@map("tapals")
}

model Movement {
  id          String   @id @default(cuid()) @map("_id")
  tapalId     String
  tapal       Tapal    @relation(fields: [tapalId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User     @relation("FromUser", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("ToUser", fields: [toUserId], references: [id])
  actionTaken String
  remarks     String?
  timestamp   DateTime @default(now())

  @@index([tapalId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("movements")
}

enum TapalType {
  Inward
  Outward
  Internal
}

enum TapalStatus {
  New
  InProgress @map("In-Progress")
  Resolved
  Returned
}
